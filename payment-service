3. Service manifest

apiVersion: v1
kind: Service
metadata:
  name: payment-service
  namespace: prereg
  labels:
    app.kubernetes.io/component: mosip
    app.kubernetes.io/instance: payment-service
    app.kubernetes.io/managed-by: kubectl
    app.kubernetes.io/name: payment-service
spec:
  type: ClusterIP
  ports:
    - name: http
      port: 80
      targetPort: 8082
      protocol: TCP
  selector:
    app.kubernetes.io/instance: payment-service
    app.kubernetes.io/name: payment-service
  sessionAffinity: None




4. Virtual service manifest

apiVersion: networking.istio.io/v1beta1
kind: VirtualService
metadata:
  name: payment-service
  namespace: prereg
  labels:
    app.kubernetes.io/component: mosip
    app.kubernetes.io/instance: payment-service
    app.kubernetes.io/managed-by: kubectl
    app.kubernetes.io/name: payment-service
spec:
  hosts:
    - "*"
  gateways:
    - istio-system/internal
  http:
    - headers:
        request:
          set:
            x-forwarded-proto: https
      match:
        - uri:
            prefix: /v1/payment
      route:
        - destination:
            host: payment-service
            port:
              number: 80



