
1. Deployment manifest

APWRD-Server-VM01@APWRD-Server-VM:~/svg/svg-uid-payment-manifests$ cat payment-service-deployment.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: payment-service
  namespace: prereg
  labels:
    app.kubernetes.io/component: mosip
    app.kubernetes.io/instance: payment-service
    app.kubernetes.io/managed-by: kubectl
    app.kubernetes.io/name: payment-service
spec:
  replicas: 1
  revisionHistoryLimit: 10
  selector:
    matchLabels:
      app.kubernetes.io/instance: payment-service
      app.kubernetes.io/name: payment-service
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxSurge: 25%
      maxUnavailable: 25%
  template:
    metadata:
      labels:
        app.kubernetes.io/instance: payment-service
        app.kubernetes.io/name: payment-service
        app.kubernetes.io/component: mosip
    spec:
      containers:
        - name: payment-service
          image: apwrd2/paymentservice:09102026-1_DEV
          imagePullPolicy: Always
          ports:
            - name: spring-service
              containerPort: 8082
              protocol: TCP
          env:
            - name: JDK_JAVA_OPTIONS
              value: "-Xms256M -Xmx750M"
            - name: SPRING_PROFILES_ACTIVE
              value: "sandbox"
            - name: SPRING_CONFIG_ADDITIONAL_LOCATION
              value: "file:/config/"
          volumeMounts:
            - name: app-config
              mountPath: /config
              readOnly: true
          startupProbe:
            tcpSocket:
              port: 8082
            periodSeconds: 10
            failureThreshold: 30
          readinessProbe:
            tcpSocket:
              port: 8082
            periodSeconds: 10
            timeoutSeconds: 5
            failureThreshold: 6
          livenessProbe:
            tcpSocket:
              port: 8082
            initialDelaySeconds: 40
            periodSeconds: 30
            timeoutSeconds: 5
            failureThreshold: 6
          resources:
            requests:
              cpu: 100m
              memory: 500Mi
            limits:
              cpu: 500m
              memory: 1500Mi
      volumes:
        - name: app-config
          secret:
            secretName: payment-service-config
      restartPolicy: Always
      terminationGracePeriodSeconds: 30
      dnsPolicy: ClusterFirst



